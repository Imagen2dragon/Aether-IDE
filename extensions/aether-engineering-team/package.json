{
	"name": "aether-engineering-team",
	"displayName": "Aether Engineering Team",
	"description": "Plan and review workspace tasks with Aether's specialist roles.",
	"version": "0.1.0",
	"publisher": "aether",
	"license": "MIT",
	"main": "./extension.js",
	"extensionKind": ["ui"],
	"capabilities": { "untrustedWorkspaces": { "supported": true } },
	"engines": {
