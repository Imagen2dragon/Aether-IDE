{
	"name": "aether-mobile-studio",
	"displayName": "%displayName%",
	"description": "%description%",
	"publisher": "aether",
	"version": "0.1.0",
	"license": "MIT",
	"engines": { "vscode": "^1.148.0" },
	"extensionKind": ["workspace"],
	"main": "./extension.js",
	"capabilities": {
		"virtualWorkspaces": false,
		"untrustedWorkspaces": { "supported": true }
	},
	"contributes": {
		"commands": [
			{ "command": "aether.mobile.debugApk", "title": "%debugApk%", "category": "%displayName%" },
			{ "command": "aether.mobile.releaseBundle", "title": "%releaseBundle%", "category": "%displayName%" },
			{ "command": "aether.mobile.listDevices", "title": "%listDevices%", "category": "%displayName%" },
			{ "command": "aether.mobile.openBuildOutput", "title": "%buildOutput%", "category": "%displayName%" }
		],
		"taskDefinitions": [
			{
				"type": "aether-android",
				"required": ["operation"],
				"properties": {
					"operation": { "type": "string", "enum": ["debugApk", "releaseBundle", "listDevices"] },
					"runId": { "type": "string" }
				}
			}
		],
		"viewsContainers": {
			"activitybar": [{ "id": "aether-mobile", "title": "%displayName%", "icon": "./mobile.svg" }],
			"panel": [{ "id": "aether-build-output", "title": "%buildOutputTitle%", "icon": "./mobile.svg" }]
		},
		"views": {
			"aether-mobile": [{ "id": "aether.mobile.android", "name": "Android" }],
			"aether-build-output": [{ "id": "aether.mobile.buildOutput", "name": "%buildOutputTitle%" }]
		},
		"viewsWelcome": [{ "view": "aether.mobile.buildOutput", "contents": "%buildOutputEmpty%" }]
	}
}
