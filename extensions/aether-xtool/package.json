{
	"name": "aether-xtool",
	"displayName": "Aether iOS Tools",
	"description": "Build xtool SwiftPM apps and list iOS devices from Mobile Studio.",
	"publisher": "aether",
	"version": "0.1.0",
	"license": "MIT",
	"engines": { "vscode": "^1.148.0" },
	"extensionKind": ["workspace"],
	"main": "./extension.js",
	"capabilities": { "virtualWorkspaces": false, "untrustedWorkspaces": { "supported": true } },
	"extensionDependencies": ["aether.aether-mobile-studio"],
	"contributes": {
		"commands": [
			{ "command": "aether.mobile.buildIOS", "title": "%buildIOS%", "category": "Mobile Studio" },
			{ "command": "aether.mobile.listIOSDevices", "title": "%listIOSDevices%", "category": "Mobile Studio" },
			{ "command": "aether.mobile.checkIOSToolchain", "title": "%checkIOSToolchain%", "category": "Mobile Studio" }
		],
		"views": {
			"aether-mobile": [{ "id": "aether.mobile.ios", "name": "iOS" }]
		},
		"taskDefinitions": [
			{ "type": "aether-xtool", "required": ["operation"], "properties": { "operation": { "type": "string", "enum": ["buildIOS", "listIOSDevices"] } } }
		],
		"configuration": {
			"title": "Aether iOS Tools",
			"properties": {
				"aether.mobile.wslDistribution": {
					"type": "string",
					"default": "",
					"scope": "machine",
					"description": "%wslDistribution%"
				}
			}
		}
	}
}
