{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AetherIDE",
  "version": "0.1.0",
  "identifier": "com.aether.ide",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1430",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "AetherIDE",
        "width": 1440,
        "height": 900,
        "minWidth": 800,
        "minHeight": 600,
        "decorations": true,
        "resizable": true,
        "backgroundColor": [30, 30, 30, 255]
      }
    ],
    "security": {
      "csp": "default-src 'self' 'unsafe-inline' 'unsafe-eval' data: blob: https:; connect-src 'self' ipc: http://ipc.localhost ws://localhost:*; script-src 'self' 'unsafe-inline' 'unsafe-eval' blob:; worker-src 'self' blob: data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "publisher": "Aether Engineering",
    "shortDescription": "AetherIDE: Production-grade AI-Native Engineering Studio",
    "longDescription": "AetherIDE is an autonomous software engineering studio built on Rust and Monaco Editor, providing real filesystem access, ConPTY terminals, and intelligent multi-agent swarms.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "installerHooks": "installer.nsh"
      }
    }
  }
}
