{
  "name": "aether-core",
  "displayName": "Aether AI Engineering Core",
  "description": "Production-grade Rust-first AI-native autonomous engineering extension for AetherIDE",
  "version": "0.1.0",
  "publisher": "aether-ide",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "AI",
    "Programming Languages",
    "Debuggers",
    "Formatters"
  ],
  "main": "./dist/extension.js",
  "browser": "./dist/web/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "aether-activity-bar",
          "title": "Aether AI",
          "icon": "resources/aether-icon.svg"
        },
        {
          "id": "aether-mobile-bar",
          "title": "Mobile App",
          "icon": "resources/mobile-icon.svg"
        },
        {
          "id": "aether-brain-bar",
          "title": "Project Brain",
          "icon": "resources/brain-icon.svg"
        }
      ]
    },
    "views": {
      "aether-activity-bar": [
        {
          "type": "webview",
          "id": "aether.agentView",
          "name": "Autonomous Agents"
        },
        {
          "type": "webview",
          "id": "aether.modelArenaView",
          "name": "Model Control & Arena"
        },
        {
          "type": "webview",
          "id": "aether.doctorView",
          "name": "Environment Doctor"
        }
      ],
      "aether-mobile-bar": [
        {
          "type": "webview",
          "id": "aether.mobileStudioView",
          "name": "Mobile Studio & EAS Cloud"
        }
      ],
      "aether-brain-bar": [
        {
          "type": "webview",
          "id": "aether.brainView",
          "name": "Living Project Graph & Impact Radar"
        }
      ]
    },
    "commands": [
      {
        "command": "aether.openChat",
        "title": "Aether: Open AI Engineering Chat"
      },
      {
        "command": "aether.spawnAgent",
        "title": "Aether: Delegate Task to Autonomous Agent"
      },
      {
        "command": "aether.inspectImpact",
        "title": "Aether: Calculate Change Impact Radar"
      },
      {
        "command": "aether.mobileScaffold",
        "title": "Aether: Scaffold Expo Mobile App"
      },
      {
        "command": "aether.runDoctor",
        "title": "Aether: Run Environment Doctor"
      }
    ],
    "configuration": {
      "title": "Aether IDE",
      "properties": {
        "aether.daemonPort": {
          "type": "number",
          "default": 44888,
          "description": "Port of the local Aether Rust daemon"
        },
        "aether.defaultModel": {
          "type": "string",
          "default": "claude-3-5-sonnet",
          "description": "Default AI model for tasks"
        },
        "aether.autonomyMode": {
          "type": "string",
          "enum": ["Observe", "Assist", "Autopilot"],
          "default": "Assist",
          "description": "Autonomy level for AI engineering agents"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.4.5"
  }
}
